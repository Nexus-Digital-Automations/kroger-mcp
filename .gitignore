# Virtual environment
venv/
.venv/

# Local Storage / Memory
# Blanket-ignore runtime JSON (tokens, kroger_cart.json, recipes, analytics dumps).
# kroger_cart.json is covered here — no separate entry needed.
*.json
# …but the root project manifest must be tracked so `npm run e2e:gate` ships with
# the repo. Leading slash anchors to repo root — never un-ignores node_modules/**/package.json.
!/package.json
# …and the MCP client config (Kroger MCP over ssh-stdio to prod). No secrets — just
# the ssh launch command; real creds stay in prod's gitignored .env.
!/.mcp.json

# Node tooling for the Playwright E2E suite (installed locally, never committed).
node_modules/

# Token files
.kroger_token*

# Claude session runtime files
.claude-session.pid

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Environment variables
.env
.env.*
*.key
*.pem
*.p12
*credentials*
*secrets*

# IDE files
.idea/
.vscode/

# Test coverage
.coverage
coverage/
htmlcov/

# Logs
*.log


.pytest_cache/
.mypy_cache/
.cache/

# SQLite WAL/SHM temporary files
*.db-shm
*.db-wal
data/kroger_analytics.db

# Playwright screenshots — regenerated by every test run
tests/playwright/screenshots/

# frontend-bug-finder runtime — throwaway creds + per-run route maps
tests/e2e/_discovery/account.json
tests/e2e/_discovery/route-map.json
test-results/

# Multi-tenant migration artifacts — local-only state
data/backups/
data/legacy/

# Playwright MCP runtime artifacts
.playwright-mcp/

# Claude Code session artifacts (per-session pid + tooling data)
.claude-session.pid
.claude/

# macOS finder metadata
.DS_Store
**/.DS_Store

# Validation artifacts (ephemeral test output)
.validation-artifacts/

# Generated/ephemeral artifacts (benchmarks, images, visual checks)
output/

# Claude Code workspace
.claude/

# macOS clutter
.DS_Store
