<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Unique identifier -->
  <key>Label</key>
  <string>com.user.kroger-discount-scanner</string>

  <!-- Command to run -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/usr/local/bin/kroger-scanner-wrapper</string>
  </array>

  <!-- Start at login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Schedule: daily at 9:00 AM (omitting Weekday = every day). Catches
       favorite price drops within a day; the watchlist scan rides along. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Logging -->
  <key>StandardOutPath</key>
  <string>/tmp/kroger-scanner-out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/kroger-scanner-err.log</string>

  <!-- Environment variables (REPLACE WITH YOUR VALUES) -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>KROGER_CLIENT_ID</key>
    <string>YOUR_CLIENT_ID_HERE</string>
    <key>KROGER_CLIENT_SECRET</key>
    <string>YOUR_CLIENT_SECRET_HERE</string>
    <!-- Must be KROGER_LOCATION_ID: that is the name background_scanner.py
         reads. An earlier template exported KROGER_PREFERRED_LOCATION, which
         nothing consumes, so the watchlist scan found no location and quietly
         did nothing. -->
    <key>KROGER_LOCATION_ID</key>
    <string>YOUR_LOCATION_ID_HERE</string>
  </dict>
</dict>
</plist>
