# Kroger API Configuration
# Get these from https://developer.kroger.com/

# Your Kroger API client ID (required)
KROGER_CLIENT_ID=your_client_id_here

# Your Kroger API client secret (required)
KROGER_CLIENT_SECRET=your_client_secret_here

# OAuth redirect URI - must match what's registered in Kroger Developer Portal
# Default for local development:
KROGER_REDIRECT_URI=http://localhost:8000/callback

# Preferred Kroger store location ID (persists across all sessions — no setup needed)
# Find your location ID: location(action='search', zip_code='YOUR_ZIP')
KROGER_LOCATION_ID=your_location_id_here

# Optional: Default zip code for location searches
# This will be used when no zip code is specified in searches
KROGER_USER_ZIP_CODE=90274

# Example of other common zip codes:
# KROGER_USER_ZIP_CODE=10001  # Manhattan, NY
# KROGER_USER_ZIP_CODE=90210  # Beverly Hills, CA
# KROGER_USER_ZIP_CODE=60601  # Chicago, IL
# KROGER_USER_ZIP_CODE=30309  # Atlanta, GA

# Notion Integration (optional - enables recipe sync to Notion)
# Get your integration secret from https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_secret
# The page ID to create the Kroger Recipes database under
# Found in the page URL: https://notion.so/your-page-title-{WORKSPACE_ID}
NOTION_WORKSPACE_ID=your_workspace_page_id

# LLM Provider Keys (chat widget — only the DEFAULT_PROVIDER's key is required;
# unset keys just remove that provider from the picker at /api/chat/providers)
# Gemma 4 via the Gemini API — default provider (chat_engine.PROVIDER_REGISTRY)
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key
TOGETHER_API_KEY=your_together_api_key
MISTRAL_API_KEY=your_mistral_api_key
