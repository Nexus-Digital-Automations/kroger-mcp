# Security-scan suppressions — file-specific and narrow (gitignore-style).
#
# logs/subagent_stop.json is an untracked, gitignored hook artifact: a verbatim
# dump of a sub-agent's final message. The pattern-scanner "weak-hash-sha1"
# finding at this path is a hash-shaped string inside a logged
# "last_assistant_message" field — transcript CONTENT, not cryptographic usage
# in code. Not shipped, not application security surface.
logs/subagent_stop.json
#
# .mypy_cache/** is mypy's auto-generated, gitignored (.gitignore:58),
# untracked type-analysis cache (needs the trailing ** — this scanner's
# _glob_match requires an explicit ** to recurse into a directory; a bare
# ".mypy_cache/" only matches that exact literal path and silently ignores
# nothing). The pattern-scanner "unsafe-deserialization" findings at
# .mypy_cache/**/pickle.data.json and .../cPickle.data.json are the literal
# module names "pickle"/"cPickle" appearing as cached type-stub metadata — no deserialization happens here; these files are regenerated by mypy and never shipped, so this is not source code or application security surface.
.mypy_cache/**
#
# detect-secrets flags PROVIDER_REGISTRY's "api_key_env" dict values as
# hardcoded-secret, but each value (e.g. "GEMINI_API_KEY") is the NAME of an
# environment variable to read at runtime (os.environ.get(...) elsewhere in
# this file), never the key itself — no real credential value appears here.
[tool:detect-secrets] src/kroger_mcp/web/chat_engine.py
#
# freshIdentity() generates a throwaway e2e-test password per run from
# Date.now()/Math.random() (e.g. "Pw!E2E<random>") — never a fixed or real
# credential, and the account is disposable (torn down after the suite).
[tool:detect-secrets] tests/e2e/onboarding.spec.ts
#
# Same pattern as onboarding.spec.ts: the throwaway e2e account's password is
# generated per run from a random runId, not a fixed or real credential.
[tool:detect-secrets] tests/e2e/scripts/provision-account.ts
#
# The client's api_key field is set to an explicit test-only mock literal
# (see the inline "bypass the missing-key guard" comment at that line) —
# never a real provider key.
[tool:detect-secrets] tests/test_chat_stream.py
#
# _TEST_MASTER_KEY is a fixed, valid Fernet key used ONLY to make an
# encrypt/decrypt test deterministic and hermetic (see the file's own
# comment) — a test fixture, not a production credential.
[tool:detect-secrets] tests/test_kroger_token_isolation.py
